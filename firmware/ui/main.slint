// The Claudial face.
//
// One screen, one overlay, no navigation.
//
// This is a thing you glance at, not one you operate, so it has no pages, no
// tabs and no back buttons. The dial answers the three questions worth asking —
// how much is left, how fast am I spending it, will the week hold — and the
// board's own telemetry is a diagnostics overlay you open from the status pill
// when something looks wrong.
//
// Two rules from measured frame cost shape the drawing:
//
//   - Dots and bars, not filled arcs. A conic-gradient ring is one 400 x 400
//     fill, some 160 000 pixels at ~0.6 us each. A ring of dots is a few
//     thousand, and only the dots that changed state repaint.
//   - Nothing here ticks. Every element changes when a snapshot arrives, once
//     a minute, so the panel renders no frames at all in between. The clock is
//     hours and minutes for the same reason; seconds would repaint the whole
//     dial sixty times more often than the data behind it changes.

global Palette {
    out property <color> bg: #000000;
    out property <color> ink: #f7f4f0;
    // Deliberately brighter than a desktop theme would use. This is read at
    // arm's length across a desk, often dimmed, so the low-contrast greys that
    // look refined on a monitor are simply unreadable here.
    out property <color> mid: #a49a91;
    out property <color> dim: #776e66;
    // Warm coral for the session window, amber for the weekly one: two warm
    // hues that stay apart on AMOLED black without either reading as an alarm
    // until it actually is one.
    out property <color> session: #e08a63;
    out property <color> weekly: #d9a441;
    out property <color> danger: #e0534f;
    out property <color> ok: #6fc08a;
    out property <color> track: #2b2523;
    out property <color> panel: #14100f;
    out property <color> panel-line: #322b27;
}

// The session ring.
//
// `lit` rounds up so a window that has only just been touched still shows one
// lit dot rather than reading as untouched.
component DotRing inherits Rectangle {
    in property <int> count: 60;
    in property <length> radius: 196px;
    in property <length> dot: 13px;
    in property <int> percent: 0;
    in property <color> accent;

    property <float> lit: root.percent <= 0 ? 0 : Math.max(1, Math.ceil(root.count * root.percent / 100));

    width: 100%;
    height: 100%;

    for i in root.count: Rectangle {
        property <angle> a: -90deg + 360deg * i / root.count;
        x: root.width / 2 + root.radius * Math.cos(self.a) - root.dot / 2;
        y: root.height / 2 + root.radius * Math.sin(self.a) - root.dot / 2;
        width: root.dot;
        height: root.dot;
        border-radius: root.dot / 2;
        background: i < root.lit ? root.accent : Palette.track;
    }
}

// Battery drawn from rectangles rather than a glyph: the embedded font has no
// battery, and a shape that fills as the charge does says more than a number.
component BatteryIcon inherits Rectangle {
    in property <int> percent: 0;
    in property <bool> charging: false;

    property <color> tint: root.charging ? Palette.ok : root.percent <= 15 ? Palette.danger : Palette.mid;

    width: 26px;
    height: 14px;

    Rectangle {
        width: 22px;
        height: 100%;
        border-radius: 4px;
        border-width: 1.5px;
        border-color: root.tint;

        Rectangle {
            x: 2.5px;
            y: 2.5px;
            width: Math.max(0, Math.min(100, root.percent)) * 17px / 100;
            height: parent.height - 5px;
            border-radius: 2px;
            background: root.tint;
        }
    }

    // The nub.
    Rectangle {
        x: 22px;
        y: 4px;
        width: 3px;
        height: 6px;
        border-radius: 1px;
        background: root.tint;
    }
}

// Rate of spend over the session window, one bar per bucket.
//
// This is the question the percentage cannot answer: 40 % in half an hour and
// 40 % over four hours look identical on the ring and mean very different
// things. Bars are normalised to the busiest bucket, so the shape shows the
// pattern of the window rather than an absolute that would flatten to nothing
// on a quiet day.
component Sparkline inherits Rectangle {
    in property <[float]> buckets;
    in property <color> accent;

    property <length> gap: 1px;
    property <length> bar: (root.width - root.gap * (root.buckets.length - 1)) / Math.max(1, root.buckets.length);

    for v[i] in root.buckets: Rectangle {
        x: i * (root.bar + root.gap);
        width: root.bar;
        // A floor of one pixel keeps an idle stretch visible as a baseline
        // instead of a gap, so the window's length always reads.
        height: Math.max(1px, v * root.height);
        y: root.height - self.height;
        background: v > 0 ? root.accent : Palette.track;
    }
}

component StepButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    width: 46px;
    height: 40px;
    border-radius: 12px;
    background: touch.pressed ? Palette.session : Palette.track;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.label;
        color: touch.pressed ? Palette.bg : Palette.ink;
        font-size: 22px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> accent: Palette.ink;

    height: 30px;

    Text {
        x: 0px;
        text: root.label;
        color: Palette.dim;
        font-size: 14px;
        vertical-alignment: center;
        height: 100%;
    }

    Text {
        x: parent.width - self.width;
        text: root.value;
        color: root.accent;
        font-size: 14px;
        vertical-alignment: center;
        height: 100%;
    }
}

export component MainWindow inherits Window {
    // Usage — the reason the thing exists.
    in property <int> usage-session: 0;
    in property <int> usage-weekly: 0;
    in property <string> usage-session-reset: "--";
    in property <string> usage-weekly-reset: "--";
    in property <string> usage-rate: "";
    in property <[float]> usage-history;
    in property <bool> linked: false;

    // Status.
    in property <int> battery-percent: 0;
    in property <bool> battery-charging: false;
    in property <string> clock: "--:--";

    // Diagnostics only.
    in property <string> uptime: "0 s";
    in property <string> ble-status: "initialized";
    in property <string> touch-status: "starting";
    in property <string> pmic-status: "probing";
    in property <string> battery-voltage: "--";
    in property <string> vbus-voltage: "--";
    in property <string> vsys-voltage: "--";
    in property <string> pmic-temperature: "--";
    in property <string> power-source: "probing";
    in property <string> usage-status: "waiting for host";
    in property <string> rtc-status: "waiting for host";

    in-out property <int> brightness-percent: 80;
    in-out property <bool> show-diagnostics: false;
    in-out property <bool> show-power-menu: false;

    callback brightness-step(int);
    callback power-off();
    callback reboot();

    property <color> session-accent: root.usage-session >= 100 ? Palette.danger : Palette.session;
    property <color> weekly-accent: root.usage-weekly >= 100 ? Palette.danger : Palette.weekly;

    width: 480px;
    height: 480px;
    background: Palette.bg;
    title: "Claudial";

    DotRing {
        count: 60;
        radius: 196px;
        dot: 13px;
        percent: root.usage-session;
        accent: root.session-accent;
    }

    // --- Status pill ------------------------------------------------------
    //
    // Also the way into diagnostics: the place you look when you want to know
    // whether the thing is connected is the place that tells you more.

    status := TouchArea {
        x: 140px;
        y: 76px;
        width: 200px;
        height: 34px;
        clicked => {
            root.show-diagnostics = true;
        }

        Rectangle {
            border-radius: 17px;
            background: status.pressed ? Palette.track : Palette.panel;
            border-width: 1px;
            border-color: Palette.panel-line;

            BatteryIcon {
                x: 16px;
                y: 10px;
                percent: root.battery-percent;
                charging: root.battery-charging;
            }

            Text {
                x: 48px;
                text: root.battery-percent + "%";
                color: Palette.mid;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                height: 100%;
            }

            Rectangle {
                x: 100px;
                y: 11px;
                width: 1px;
                height: 12px;
                background: Palette.panel-line;
            }

            Rectangle {
                x: 118px;
                y: 14px;
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.linked ? Palette.ok : Palette.danger;
            }

            Text {
                x: 133px;
                text: root.linked ? "LINK" : "NO HOST";
                color: root.linked ? Palette.mid : Palette.danger;
                font-size: 13px;
                font-weight: 600;
                letter-spacing: 0.5px;
                vertical-alignment: center;
                height: 100%;
            }
        }
    }

    // --- Session ----------------------------------------------------------

    Text {
        x: 0px;
        y: 118px;
        width: 480px;
        height: 96px;
        text: root.usage-session + "%";
        color: root.session-accent;
        font-size: 84px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Text {
        x: 0px;
        y: 214px;
        width: 480px;
        text: "SESSION  ·  " + root.usage-session-reset;
        color: Palette.mid;
        font-size: 15px;
        letter-spacing: 0.8px;
        horizontal-alignment: center;
    }

    // --- Rate -------------------------------------------------------------

    Sparkline {
        x: 140px;
        y: 250px;
        width: 200px;
        height: 34px;
        buckets: root.usage-history;
        accent: root.session-accent;
    }

    Text {
        x: 0px;
        y: 290px;
        width: 480px;
        text: root.usage-rate;
        color: Palette.dim;
        font-size: 13px;
        letter-spacing: 0.6px;
        horizontal-alignment: center;
    }

    Rectangle {
        x: 160px;
        y: 316px;
        width: 160px;
        height: 1px;
        background: Palette.panel-line;
    }

    // --- Weekly -----------------------------------------------------------

    Text {
        x: 130px;
        y: 332px;
        width: 120px;
        height: 22px;
        text: "WEEKLY";
        color: Palette.dim;
        font-size: 13px;
        letter-spacing: 1px;
        vertical-alignment: center;
    }

    Text {
        x: 230px;
        y: 332px;
        width: 120px;
        height: 22px;
        text: root.usage-weekly + "%";
        color: root.weekly-accent;
        font-size: 18px;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Rectangle {
        x: 130px;
        y: 362px;
        width: 220px;
        height: 10px;
        border-radius: 5px;
        background: Palette.track;

        Rectangle {
            x: 0px;
            width: Math.max(0, Math.min(100, root.usage-weekly)) * parent.width / 100;
            height: 100%;
            border-radius: 5px;
            background: root.weekly-accent;
        }
    }

    Text {
        x: 0px;
        y: 380px;
        width: 480px;
        text: root.usage-weekly-reset;
        color: Palette.dim;
        font-size: 13px;
        horizontal-alignment: center;
    }

    Text {
        x: 0px;
        y: 406px;
        width: 480px;
        text: root.clock;
        color: Palette.dim;
        font-size: 15px;
        horizontal-alignment: center;
    }

    // --- Diagnostics ------------------------------------------------------

    if root.show-diagnostics: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000f2;

        TouchArea {
            clicked => {
                root.show-diagnostics = false;
            }
        }

        Rectangle {
            x: 56px;
            y: 56px;
            width: 368px;
            height: 368px;
            border-radius: 24px;
            background: Palette.panel;
            border-width: 1px;
            border-color: Palette.panel-line;

            // Keeps taps inside the card from reaching the dismiss backdrop.
            TouchArea { }

            VerticalLayout {
                x: 40px;
                y: 28px;
                width: 288px;
                spacing: 0px;

                InfoRow {
                    label: "Host link";
                    value: root.usage-status;
                    accent: root.linked ? Palette.ok : Palette.danger;
                }

                InfoRow {
                    label: "BLE";
                    value: root.ble-status;
                }

                InfoRow {
                    label: "Clock";
                    value: root.rtc-status;
                }

                InfoRow {
                    label: "Touch";
                    value: root.touch-status;
                }

                InfoRow {
                    label: "PMIC";
                    value: root.pmic-status;
                }

                InfoRow {
                    label: "Battery";
                    value: root.battery-voltage;
                }

                InfoRow {
                    label: "VBUS / VSYS";
                    value: root.vbus-voltage + "  " + root.vsys-voltage;
                }

                InfoRow {
                    label: "Die temp";
                    value: root.pmic-temperature;
                }

                InfoRow {
                    label: "Source";
                    value: root.power-source;
                }

                InfoRow {
                    label: "Uptime";
                    value: root.uptime;
                }
            }

            Text {
                x: 40px;
                y: 344px;
                width: 90px;
                height: 40px;
                text: "Brightness";
                color: Palette.dim;
                font-size: 14px;
                vertical-alignment: center;
            }

            StepButton {
                x: 140px;
                y: 344px;
                label: "-";
                clicked => {
                    root.brightness-step(-5);
                }
            }

            Text {
                x: 190px;
                y: 344px;
                width: 46px;
                height: 40px;
                text: root.brightness-percent + "%";
                color: Palette.ink;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            StepButton {
                x: 240px;
                y: 344px;
                label: "+";
                clicked => {
                    root.brightness-step(5);
                }
            }

            power-touch := TouchArea {
                x: 296px;
                y: 344px;
                width: 40px;
                height: 40px;
                clicked => {
                    root.show-diagnostics = false;
                    root.show-power-menu = true;
                }

                Rectangle {
                    border-radius: 12px;
                    background: power-touch.pressed ? Palette.danger : Palette.track;

                    Text {
                        text: "!";
                        color: Palette.ink;
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }

    // --- Power menu -------------------------------------------------------

    if root.show-power-menu: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000f2;

        TouchArea {
            clicked => {
                root.show-power-menu = false;
            }
        }

        Rectangle {
            x: 76px;
            y: 108px;
            width: 328px;
            height: 264px;
            border-radius: 20px;
            background: Palette.panel;
            border-width: 1px;
            border-color: Palette.panel-line;

            TouchArea { }

            Text {
                x: 0px;
                y: 26px;
                width: parent.width;
                text: "POWER";
                color: Palette.dim;
                font-size: 12px;
                letter-spacing: 1.6px;
                horizontal-alignment: center;
            }

            power-off-touch := TouchArea {
                x: 24px;
                y: 66px;
                width: 280px;
                height: 52px;
                clicked => {
                    root.show-power-menu = false;
                    root.power-off();
                }

                Rectangle {
                    border-radius: 14px;
                    background: power-off-touch.pressed ? #8f2f2c : Palette.danger;

                    Text {
                        text: "POWER OFF";
                        color: Palette.bg;
                        font-size: 15px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }

            reboot-touch := TouchArea {
                x: 24px;
                y: 130px;
                width: 280px;
                height: 52px;
                clicked => {
                    root.show-power-menu = false;
                    root.reboot();
                }

                Rectangle {
                    border-radius: 14px;
                    background: reboot-touch.pressed ? #8c6a2a : Palette.weekly;

                    Text {
                        text: "RESTART";
                        color: Palette.bg;
                        font-size: 15px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }

            cancel-touch := TouchArea {
                x: 24px;
                y: 194px;
                width: 280px;
                height: 46px;
                clicked => {
                    root.show-power-menu = false;
                }

                Rectangle {
                    border-radius: 14px;
                    background: cancel-touch.pressed ? Palette.track : Palette.bg;
                    border-width: 1px;
                    border-color: Palette.panel-line;

                    Text {
                        text: "CANCEL";
                        color: Palette.mid;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }
}
