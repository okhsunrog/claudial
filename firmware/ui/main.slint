// The Claudial face.
//
// The dial is the point of the instrument, so it is the screen you get: two
// concentric rings of dots, session outside and weekly inside, around the
// numbers. Everything the board can also do — brightness, clock, power,
// telemetry — is one tap away behind the gear and never in the way.
//
// Two rules shape the drawing, both from measured frame cost:
//
//   - Dots, not filled arcs. A conic-gradient ring is one 400 x 400 fill,
//     about 160 000 pixels at ~0.6 us each. A ring of dots is a few thousand,
//     and only the dots that actually changed state are repainted.
//   - Nothing animated shares a screen with the rings. The sprite lives on its
//     own page, so its dirty region never drags the dial along with it.

global Palette {
    out property <color> bg: #000000;
    out property <color> ink: #f2ede7;
    out property <color> dim: #7d746c;
    out property <color> faint: #4a423c;
    // Warm coral for the session window, amber for the weekly one: two warm
    // hues that stay distinguishable on AMOLED black without either reading
    // as an alarm until it actually is one.
    out property <color> session: #d97757;
    out property <color> weekly: #d9a441;
    out property <color> danger: #e0534f;
    out property <color> track: #241f1c;
    out property <color> panel: #100d0c;
    out property <color> panel-line: #2a2421;
}

// One ring of the dial.
//
// `lit` rounds up, so a window that has only just been touched still shows a
// single lit dot rather than reading as untouched.
component DotRing inherits Rectangle {
    in property <int> count: 64;
    in property <length> radius: 208px;
    in property <length> dot: 12px;
    in property <int> percent: 0;
    in property <color> accent;

    property <float> lit: root.percent <= 0 ? 0 : Math.max(1, Math.ceil(root.count * root.percent / 100));

    width: 100%;
    height: 100%;

    for i in root.count: Rectangle {
        property <angle> a: -90deg + 360deg * i / root.count;
        x: root.width / 2 + root.radius * Math.cos(self.a) - root.dot / 2;
        y: root.height / 2 + root.radius * Math.sin(self.a) - root.dot / 2;
        width: root.dot;
        height: root.dot;
        border-radius: root.dot / 2;
        background: i < root.lit ? root.accent : Palette.track;
    }
}

// A small pill used for status, never for actions.
component Chip inherits Rectangle {
    in property <string> label;
    in property <color> accent: Palette.dim;
    in property <bool> lit: false;

    height: 26px;
    width: text.width + 34px;
    border-radius: 13px;
    background: Palette.panel;
    border-width: 1px;
    border-color: Palette.panel-line;

    Rectangle {
        x: 11px;
        y: parent.height / 2 - 3px;
        width: root.lit ? 6px : 0px;
        height: 6px;
        border-radius: 3px;
        background: root.accent;
    }

    text := Text {
        x: root.lit ? 23px : 15px;
        text: root.label;
        color: root.accent;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.6px;
        vertical-alignment: center;
        height: parent.height;
    }
}

// A round tap target. Used for the gear and the back arrow, which are the only
// two controls that live outside a list.
component RoundButton inherits Rectangle {
    in property <string> glyph;
    in property <color> accent: Palette.dim;
    callback clicked();

    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: touch.pressed ? Palette.track : Palette.panel;
    border-width: 1px;
    border-color: Palette.panel-line;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.glyph;
        color: root.accent;
        font-size: 18px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

component StepButton inherits Rectangle {
    in property <string> label;
    in property <color> accent: Palette.session;
    callback clicked();

    width: 44px;
    height: 40px;
    border-radius: 12px;
    background: touch.pressed ? root.accent : Palette.track;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Text {
        text: root.label;
        color: touch.pressed ? Palette.bg : root.accent;
        font-size: 20px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
}

// A settings row: label on the left, value on the right, optional chevron.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> value: "";
    in property <bool> navigates: false;
    in property <color> accent: Palette.ink;
    callback clicked();

    height: 56px;
    border-radius: 14px;
    background: touch.pressed ? Palette.track : Palette.panel;
    border-width: 1px;
    border-color: Palette.panel-line;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Text {
        x: 18px;
        text: root.label;
        color: Palette.ink;
        font-size: 16px;
        vertical-alignment: center;
        height: 100%;
    }

    Text {
        x: parent.width - self.width - (root.navigates ? 34px : 18px);
        text: root.value;
        color: root.accent;
        font-size: 15px;
        vertical-alignment: center;
        height: 100%;
    }

    if root.navigates: Text {
        x: parent.width - 24px;
        text: ">";
        color: Palette.faint;
        font-size: 16px;
        vertical-alignment: center;
        height: 100%;
    }
}

// A read-only telemetry line.
component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 34px;

    Text {
        x: 0px;
        text: root.label;
        color: Palette.dim;
        font-size: 14px;
        vertical-alignment: center;
        height: 100%;
    }

    Text {
        x: parent.width - self.width;
        text: root.value;
        color: Palette.ink;
        font-size: 14px;
        vertical-alignment: center;
        height: 100%;
    }
}

component ValueStepper inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback step(int);

    height: 40px;

    Text {
        x: 0px;
        width: 46px;
        text: root.label;
        color: Palette.dim;
        font-size: 13px;
        vertical-alignment: center;
        height: 100%;
    }

    Text {
        x: 50px;
        width: 54px;
        text: root.value;
        color: Palette.ink;
        font-size: 20px;
        font-weight: 700;
        vertical-alignment: center;
        height: 100%;
    }

    StepButton {
        x: 108px;
        label: "-";
        clicked => {
            root.step(-1);
        }
    }

    StepButton {
        x: 158px;
        label: "+";
        clicked => {
            root.step(1);
        }
    }
}

// Per-cell rectangles rather than one image: the software renderer then only
// repaints the cells whose colour actually changed between frames.
component SpriteGrid inherits Rectangle {
    in property <[color]> cells;
    in property <int> grid: 20;
    in property <length> cell-size: 16px;

    width: root.grid * root.cell-size;
    height: root.width;

    for cell[i] in root.cells: Rectangle {
        x: Math.mod(i, root.grid) * root.cell-size;
        y: Math.floor(i / root.grid) * root.cell-size;
        width: root.cell-size;
        height: root.cell-size;
        background: cell;
    }
}

export component MainWindow inherits Window {
    // Usage — the reason the thing exists.
    in property <int> usage-session: 0;
    in property <int> usage-weekly: 0;
    in property <string> usage-session-reset: "--";
    in property <string> usage-weekly-reset: "--";
    in property <string> usage-status: "waiting for host";

    in property <[color]> sprite-cells;
    in property <string> sprite-name: "--";

    in property <string> uptime: "0 s";
    in property <string> ble-status: "initialized";
    in property <string> touch-status: "CST9220 starting";
    in property <string> pmic-status: "AXP2101 probing";
    in property <string> battery-level: "--";
    in property <string> battery-voltage: "--";
    in property <string> vbus-voltage: "--";
    in property <string> vsys-voltage: "--";
    in property <string> pmic-temperature: "--";
    in property <string> power-source: "probing";
    in property <string> rtc-time: "--:--:--";
    in property <string> rtc-date: "---- -- --";
    in property <string> rtc-status: "RTC starting";
    in property <bool> rtc-clock-valid: false;
    in-out property <int> rtc-edit-year: 2026;
    in-out property <int> rtc-edit-month: 1;
    in-out property <int> rtc-edit-day: 1;
    in-out property <int> rtc-edit-hour: 0;
    in-out property <int> rtc-edit-minute: 0;
    in-out property <int> rtc-edit-second: 0;
    in-out property <bool> rtc-edit-dirty: false;
    in-out property <int> brightness-percent: 80;

    // 0 dial · 1 sprite · 2 settings · 3 clock · 4 system.
    // The firmware only cares that 1 is the sprite, which is the one page that
    // needs an animation deadline.
    in-out property <int> current-page: 0;
    in-out property <bool> show-power-menu: false;

    callback sprite-next();
    callback brightness-step(int);
    callback rtc-step(int, int);
    callback rtc-save();
    callback power-off();
    callback reboot();

    // A window that has run out is the one thing worth shouting about.
    property <color> session-accent: root.usage-session >= 100 ? Palette.danger : Palette.session;
    property <color> weekly-accent: root.usage-weekly >= 100 ? Palette.danger : Palette.weekly;
    property <bool> linked: root.usage-status != "waiting for host";

    width: 480px;
    height: 480px;
    background: Palette.bg;
    title: "Claudial";

    // --- Dial -------------------------------------------------------------

    if root.current-page == 0: Rectangle {
        width: 100%;
        height: 100%;

        DotRing {
            count: 64;
            radius: 208px;
            dot: 12px;
            percent: root.usage-session;
            accent: root.session-accent;
        }

        DotRing {
            count: 52;
            radius: 178px;
            dot: 9px;
            percent: root.usage-weekly;
            accent: root.weekly-accent;
        }

        // Anywhere in the middle flips to the sprite, the way Clawdmeter's
        // splash works. Declared before the gear so the gear keeps its corner.
        TouchArea {
            x: 120px;
            y: 96px;
            width: 240px;
            height: 250px;
            clicked => {
                root.current-page = 1;
            }
        }

        Chip {
            x: 240px - self.width / 2;
            y: 112px;
            label: root.linked ? "LINKED" : "NO HOST";
            accent: root.linked ? Palette.session : Palette.faint;
            lit: root.linked;
        }

        Text {
            x: 0px;
            y: 146px;
            width: 480px;
            height: 88px;
            text: root.usage-session + "%";
            color: root.session-accent;
            font-size: 76px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            x: 0px;
            y: 234px;
            width: 480px;
            text: "SESSION · " + root.usage-session-reset;
            color: Palette.dim;
            font-size: 15px;
            letter-spacing: 0.8px;
            horizontal-alignment: center;
        }

        Rectangle {
            x: 170px;
            y: 268px;
            width: 140px;
            height: 1px;
            background: Palette.panel-line;
        }

        Text {
            x: 0px;
            y: 282px;
            width: 480px;
            height: 40px;
            text: root.usage-weekly + "%";
            color: root.weekly-accent;
            font-size: 34px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            x: 0px;
            y: 324px;
            width: 480px;
            text: "WEEKLY · " + root.usage-weekly-reset;
            color: Palette.dim;
            font-size: 13px;
            letter-spacing: 0.8px;
            horizontal-alignment: center;
        }

        // Deliberately no clock here. A ticking seconds field would repaint
        // this page once a second, and with the rings on it that costs three
        // times what the same repaint costs on a plain page — for a number
        // this instrument is not about. The clock lives behind the gear.
        Text {
            x: 0px;
            y: 352px;
            width: 480px;
            height: 30px;
            text: root.battery-level;
            color: Palette.faint;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        RoundButton {
            x: 220px;
            y: 392px;
            glyph: "=";
            clicked => {
                root.current-page = 2;
            }
        }
    }

    // --- Sprite -----------------------------------------------------------

    if root.current-page == 1: Rectangle {
        width: 100%;
        height: 100%;

        Text {
            x: 0px;
            y: 34px;
            width: 480px;
            text: root.sprite-name;
            color: Palette.dim;
            font-size: 13px;
            letter-spacing: 1.2px;
            horizontal-alignment: center;
        }

        // Tapping the sprite itself cycles the animation; the back arrow is
        // the only way out, so neither gesture can be hit by accident.
        sprite-touch := TouchArea {
            x: 80px;
            y: 66px;
            width: 320px;
            height: 320px;
            clicked => {
                root.sprite-next();
            }

            SpriteGrid {
                cells: root.sprite-cells;
                cell-size: 16px;
            }
        }

        Text {
            x: 0px;
            y: 400px;
            width: 480px;
            text: root.usage-session + "%   ·   " + root.usage-weekly + "%";
            color: Palette.dim;
            font-size: 18px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        RoundButton {
            x: 40px;
            y: 220px;
            glyph: "<";
            clicked => {
                root.current-page = 0;
            }
        }
    }

    // --- Settings ---------------------------------------------------------

    if root.current-page == 2: Rectangle {
        width: 100%;
        height: 100%;

        Text {
            x: 0px;
            y: 62px;
            width: 480px;
            text: "SETTINGS";
            color: Palette.dim;
            font-size: 13px;
            letter-spacing: 1.6px;
            horizontal-alignment: center;
        }

        Rectangle {
            x: 66px;
            y: 96px;
            width: 348px;
            height: 56px;
            border-radius: 14px;
            background: Palette.panel;
            border-width: 1px;
            border-color: Palette.panel-line;

            Text {
                x: 18px;
                text: "Brightness";
                color: Palette.ink;
                font-size: 16px;
                vertical-alignment: center;
                height: 100%;
            }

            Text {
                x: 146px;
                width: 54px;
                text: root.brightness-percent + "%";
                color: Palette.session;
                font-size: 15px;
                horizontal-alignment: right;
                vertical-alignment: center;
                height: 100%;
            }

            StepButton {
                x: 212px;
                y: 8px;
                label: "-";
                clicked => {
                    root.brightness-step(-5);
                }
            }

            StepButton {
                x: 288px;
                y: 8px;
                label: "+";
                clicked => {
                    root.brightness-step(5);
                }
            }
        }

        SettingRow {
            x: 66px;
            y: 162px;
            width: 348px;
            label: "Clock";
            value: root.rtc-clock-valid ? root.rtc-time : "not set";
            accent: root.rtc-clock-valid ? Palette.dim : Palette.danger;
            navigates: true;
            clicked => {
                root.current-page = 3;
            }
        }

        SettingRow {
            x: 66px;
            y: 228px;
            width: 348px;
            label: "System";
            value: root.uptime;
            accent: Palette.dim;
            navigates: true;
            clicked => {
                root.current-page = 4;
            }
        }

        SettingRow {
            x: 66px;
            y: 294px;
            width: 348px;
            label: "Power";
            value: root.power-source;
            accent: Palette.dim;
            navigates: true;
            clicked => {
                root.show-power-menu = true;
            }
        }

        RoundButton {
            x: 220px;
            y: 386px;
            glyph: "<";
            clicked => {
                root.current-page = 0;
            }
        }
    }

    // --- Clock ------------------------------------------------------------

    if root.current-page == 3: Rectangle {
        width: 100%;
        height: 100%;

        Text {
            x: 0px;
            y: 52px;
            width: 480px;
            text: root.rtc-date + "   " + root.rtc-time;
            color: Palette.ink;
            font-size: 19px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            x: 0px;
            y: 78px;
            width: 480px;
            text: root.rtc-status;
            color: root.rtc-edit-dirty ? Palette.session : Palette.dim;
            font-size: 13px;
            horizontal-alignment: center;
        }

        ValueStepper {
            x: 62px;
            y: 112px;
            width: 202px;
            label: "YEAR";
            value: root.rtc-edit-year;
            step(d) => {
                root.rtc-step(0, d);
            }
        }

        ValueStepper {
            x: 62px;
            y: 160px;
            width: 202px;
            label: "MON";
            value: root.rtc-edit-month;
            step(d) => {
                root.rtc-step(1, d);
            }
        }

        ValueStepper {
            x: 62px;
            y: 208px;
            width: 202px;
            label: "DAY";
            value: root.rtc-edit-day;
            step(d) => {
                root.rtc-step(2, d);
            }
        }

        ValueStepper {
            x: 62px;
            y: 256px;
            width: 202px;
            label: "HOUR";
            value: root.rtc-edit-hour;
            step(d) => {
                root.rtc-step(3, d);
            }
        }

        ValueStepper {
            x: 62px;
            y: 304px;
            width: 202px;
            label: "MIN";
            value: root.rtc-edit-minute;
            step(d) => {
                root.rtc-step(4, d);
            }
        }

        ValueStepper {
            x: 62px;
            y: 352px;
            width: 202px;
            label: "SEC";
            value: root.rtc-edit-second;
            step(d) => {
                root.rtc-step(5, d);
            }
        }

        save-touch := TouchArea {
            x: 288px;
            y: 186px;
            width: 130px;
            height: 52px;
            clicked => {
                root.rtc-save();
            }

            Rectangle {
                border-radius: 14px;
                background: save-touch.pressed ? Palette.danger : Palette.session;

                Text {
                    text: "SAVE";
                    color: Palette.bg;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        RoundButton {
            x: 333px;
            y: 262px;
            glyph: "<";
            clicked => {
                root.current-page = 2;
            }
        }
    }

    // --- System -----------------------------------------------------------

    if root.current-page == 4: Rectangle {
        width: 100%;
        height: 100%;

        Text {
            x: 0px;
            y: 58px;
            width: 480px;
            text: "SYSTEM";
            color: Palette.dim;
            font-size: 13px;
            letter-spacing: 1.6px;
            horizontal-alignment: center;
        }

        Rectangle {
            x: 74px;
            y: 88px;
            width: 332px;
            height: 296px;
            border-radius: 16px;
            background: Palette.panel;
            border-width: 1px;
            border-color: Palette.panel-line;

            VerticalLayout {
                x: 18px;
                y: 14px;
                width: 296px;
                spacing: 0px;

                InfoRow {
                    label: "Uptime";
                    value: root.uptime;
                }

                InfoRow {
                    label: "Host link";
                    value: root.usage-status;
                }

                InfoRow {
                    label: "BLE";
                    value: root.ble-status;
                }

                InfoRow {
                    label: "Touch";
                    value: root.touch-status;
                }

                InfoRow {
                    label: "PMIC";
                    value: root.pmic-status;
                }

                InfoRow {
                    label: "Battery";
                    value: root.battery-level + "  " + root.battery-voltage;
                }

                InfoRow {
                    label: "VBUS / VSYS";
                    value: root.vbus-voltage + "  " + root.vsys-voltage;
                }

                InfoRow {
                    label: "Die temp";
                    value: root.pmic-temperature;
                }
            }
        }

        RoundButton {
            x: 220px;
            y: 396px;
            glyph: "<";
            clicked => {
                root.current-page = 2;
            }
        }
    }

    // --- Power menu -------------------------------------------------------

    if root.show-power-menu: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000e6;

        TouchArea {
            clicked => {
                root.show-power-menu = false;
            }
        }

        Rectangle {
            x: 76px;
            y: 108px;
            width: 328px;
            height: 264px;
            border-radius: 20px;
            background: Palette.panel;
            border-width: 1px;
            border-color: Palette.panel-line;

            // Keeps taps inside the card from reaching the dismiss backdrop.
            TouchArea { }

            Text {
                x: 0px;
                y: 26px;
                width: parent.width;
                text: "POWER";
                color: Palette.dim;
                font-size: 12px;
                letter-spacing: 1.6px;
                horizontal-alignment: center;
            }

            power-off-touch := TouchArea {
                x: 24px;
                y: 66px;
                width: 280px;
                height: 52px;
                clicked => {
                    root.show-power-menu = false;
                    root.power-off();
                }

                Rectangle {
                    border-radius: 14px;
                    background: power-off-touch.pressed ? #8f2f2c : Palette.danger;

                    Text {
                        text: "POWER OFF";
                        color: Palette.bg;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }

            reboot-touch := TouchArea {
                x: 24px;
                y: 130px;
                width: 280px;
                height: 52px;
                clicked => {
                    root.show-power-menu = false;
                    root.reboot();
                }

                Rectangle {
                    border-radius: 14px;
                    background: reboot-touch.pressed ? #8c6a2a : Palette.weekly;

                    Text {
                        text: "RESTART";
                        color: Palette.bg;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }

            cancel-touch := TouchArea {
                x: 24px;
                y: 194px;
                width: 280px;
                height: 46px;
                clicked => {
                    root.show-power-menu = false;
                }

                Rectangle {
                    border-radius: 14px;
                    background: cancel-touch.pressed ? Palette.track : Palette.bg;
                    border-width: 1px;
                    border-color: Palette.panel-line;

                    Text {
                        text: "CANCEL";
                        color: Palette.dim;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }
                }
            }
        }
    }
}
